+
+bool microlink_selected_exit_ready(const microlink_t *ml)
+{
+    return ml && __atomic_load_n(&ml->selected_exit_ready, __ATOMIC_ACQUIRE);
+}
+
+static void publish_selected_exit_ready(microlink_t *ml)
+{
+    bool ready = false;
+
+    if (ml->config.exit_node_ip != 0) {
+        for (int i = 0; i < ml->peer_count; ++i) {
+            const ml_peer_t *peer = &ml->peers[i];
+            if (peer->active && peer->vpn_ip == ml->config.exit_node_ip &&
+                peer->online && peer->is_exit_node && peer->wg_peer_index >= 0 &&
+                peer->exit_route_attached) {
+                ready = true;
+                break;
+            }
+        }
+    }
+
+    __atomic_store_n(&ml->selected_exit_ready, ready, __ATOMIC_RELEASE);
+}
+
+static void publish_peer_snapshot(microlink_t *ml)
+{
+    if (!ml->peer_snapshot_lock) return;
+
+    xSemaphoreTake(ml->peer_snapshot_lock, portMAX_DELAY);
+    int count = ml->peer_count;
+    if (count > ML_MAX_PEERS) count = ML_MAX_PEERS;
+    int online = 0;
+    for (int i = 0; i < count; ++i) {
+        const ml_peer_t *peer = &ml->peers[i];
+        microlink_peer_info_t *info = &ml->peer_snapshot[i];
+        memset(info, 0, sizeof(*info));
+        info->vpn_ip = peer->vpn_ip;
+        strlcpy(info->hostname, peer->hostname, sizeof(info->hostname));
+        memcpy(info->public_key, peer->public_key, sizeof(info->public_key));
+        info->online = peer->active && peer->online;
+        info->direct_path = peer->has_direct_path;
+        info->is_exit_node = peer->is_exit_node;
+        info->derp_region = peer->derp_region;
+        info->subnet_route_count = peer->subnet_route_count;
+        if (info->subnet_route_count > MICROLINK_MAX_PEER_ROUTES) {
+            info->subnet_route_count = MICROLINK_MAX_PEER_ROUTES;
+        }
+        for (int r = 0; r < info->subnet_route_count; ++r) {
+            info->subnet_routes[r] = peer->subnet_routes[r];
+        }
+        if (info->online) ++online;
+    }
+    ml->peer_snapshot_count = count;
+    ml->peer_snapshot_online = online;
+    xSemaphoreGive(ml->peer_snapshot_lock);
+}
