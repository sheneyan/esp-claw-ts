@@ -86,0 +87,13 @@ void ml_bind_sock_to_upstream(microlink_t *ml, int fd)
+static struct ifreq *ml_upstream_ifreq(microlink_t *ml, struct ifreq *ifr)
+{
+    if (!ml || !ifr || !ml->upstream_netif) return NULL;
+    struct netif *up = (struct netif *)ml->upstream_netif;
+    if (!netif_is_up(up) || !netif_is_link_up(up)) return NULL;
+
+    memset(ifr, 0, sizeof(*ifr));
+    netif_index_to_name(netif_get_index(up), ifr->ifr_name);
+    if (ifr->ifr_name[0] == '\0') return NULL;
+
+    return ifr;
+}
