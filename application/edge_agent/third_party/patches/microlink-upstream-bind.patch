diff --git a/src/ml_peer_nvs.c b/src/ml_peer_nvs.c
--- a/src/ml_peer_nvs.c
+++ b/src/ml_peer_nvs.c
@@ -292,11 +292,13 @@ esp_err_t ml_peer_nvs_remove(const uint8_t public_key[32]) {
-esp_err_t ml_peer_nvs_clear(void) {
-    if (!s_initialized) return ESP_ERR_INVALID_STATE;
-
-    esp_err_t err = nvs_erase_all(s_nvs);
-    if (err == ESP_OK) {
-        nvs_commit(s_nvs);
-        if (s_table) memset(s_table, 0, sizeof(peer_nvs_table_t));
-        ESP_LOGI(TAG, "Peer NVS cleared");
-    }
-    return err;
-}
+esp_err_t ml_peer_nvs_clear(void) {
+    if (!s_initialized) return ESP_ERR_INVALID_STATE;
+
+    esp_err_t err = nvs_erase_all(s_nvs);
+    if (err != ESP_OK) return err;
+
+    err = nvs_commit(s_nvs);
+    if (err != ESP_OK) return err;
+
+    if (s_table) memset(s_table, 0, sizeof(peer_nvs_table_t));
+    ESP_LOGI(TAG, "Peer NVS cleared");
+    return ESP_OK;
+}
