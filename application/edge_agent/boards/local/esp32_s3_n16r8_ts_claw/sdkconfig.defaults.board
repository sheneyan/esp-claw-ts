CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP32-S3 N16R8: 16 MB QIO flash at 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# 8 MB octal PSRAM at 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Headless prototype: no LCD or Bluetooth
CONFIG_APP_CLAW_LUA_MODULE_LCD=n
CONFIG_BT_ENABLED=n

# MicroLink sizing for an N16R8 target
CONFIG_ML_ZERO_COPY_WG=n
CONFIG_ML_MAX_PEERS=16
CONFIG_ML_NVS_MAX_PEERS=64
CONFIG_ML_H2_BUFFER_SIZE_KB=512
CONFIG_ML_JSON_BUFFER_SIZE_KB=512
CONFIG_ML_ENABLE_CELLULAR=n

# Required by the MicroLink Noise transport.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
